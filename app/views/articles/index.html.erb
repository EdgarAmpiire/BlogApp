<div class="w-full sm:w-11/12 md:w-9/12 lg:w-7/12 mx-auto px-4 sm:px-6 py-6 sm:py-10 bg-white rounded-2xl shadow-md">
  <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 sm:mb-6 border-b pb-2">
    Articles
  </h1>

  <!-- Article count -->
  <p class="text-gray-600 mb-4 sm:mb-6 text-sm sm:text-base leading-relaxed">
    Our blog has 
    <span class="font-semibold text-gray-900">
      <%= Article.public_count %>
    </span> 
    articles and counting!
  </p>

  <% if @articles.any? %>
    <ul class="space-y-3 sm:space-y-4">
      <% @articles.each do |article| %>
        <% unless article.archived? %>
          <li>
            <%= link_to article.title, article, class: "block p-3 sm:p-4 bg-gray-100 rounded-lg hover:bg-gray-200 transition text-gray-900 font-medium sm:font-semibold text-sm sm:text-base" %>
          </li>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-center text-base sm:text-lg py-6 sm:py-8">
      There are no articles yet.
    </p>
  <% end %>

  <div class="mt-6 sm:mt-8 flex justify-center sm:justify-start">
    <%= link_to "New Article", new_article_path, class: "inline-block bg-gray-900 text-white font-semibold px-5 sm:px-6 py-2.5 sm:py-3 rounded-lg hover:bg-gray-800 transition text-sm sm:text-base" %>
  </div>
</div>

<%= form_with model: article, class: "space-y-6" do |form| %>
  <!-- Title field -->
  <div class="flex flex-col">
    <%= form.label :title, class: "mb-2 font-semibold text-gray-800" %>
    <%= form.text_field :title, class: "w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700" %>
    <% article.errors.full_messages_for(:title).each do |message| %>
      <div class="text-red-600 mt-1 text-sm"><%= message %></div>
    <% end %>
  </div>

  <!-- Body field -->
  <div class="flex flex-col">
    <%= form.label :body, class: "mb-2 font-semibold text-gray-800" %>
    <%= form.text_area :body, rows: 10, class: "w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700" %>
    <% article.errors.full_messages_for(:body).each do |message| %>
      <div class="text-red-600 mt-1 text-sm"><%= message %></div>
    <% end %>
  </div>


  <!-- Status field -->
  <div class="flex flex-col">
    <%= form.label :status, class: "mb-2 font-semibold text-gray-800" %>
    <%= form.select :status, Visible::VALID_STATUSES, 
        { selected: article.status || 'public' }, 
        class: "w-full p-3 border border-gray-300 rounded-lg bg-white focus:outline-none focus:ring-2 focus:ring-gray-700 cursor-pointer" %>
  </div>

  <!-- Submit button -->
   <div>
    <%= form.submit article.new_record? ? "Create" : "Update", class: "bg-gray-900 text-white font-semibold px-6 py-3 rounded-lg hover:bg-gray-800 transition cursor-pointer" %>
  </div>
<% end %>
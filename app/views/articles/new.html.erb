<div class="w-7/12 mx-auto px-6 py-10">
  <!-- Back arrow -->
  <div class="mb-6">
    <a href="<%= articles_path %>" class="text-gray-500 hover:text-gray-700 text-2xl">
      ← Back to Articles
    </a>
  </div>

  <!-- Form card -->
  <div class="bg-white rounded-2xl shadow-md p-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-6 border-b pb-2">
      New Article
    </h1>

    <%= render "form", article: @article %>
  </div>
</div>

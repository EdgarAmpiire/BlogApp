<div class="w-full sm:w-11/12 md:w-9/12 lg:w-7/12 mx-auto px-4 sm:px-6 py-6 sm:py-10">
  <!-- Back arrow -->
  <div class="mb-4 sm:mb-6">
    <%= link_to "← Back to Article", article_path(@article), class: "text-gray-500 hover:text-gray-700 text-lg sm:text-xl font-medium transition" %>
  </div>

  <!-- Form card -->
  <div class="bg-white rounded-2xl shadow-md p-4 sm:p-6 lg:p-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 sm:mb-6 border-b pb-2">
      Edit Article
    </h1>

    <%= render "form", article: @article %>
  </div>
</div>

<div class="w-7/12 mx-auto px-6 py-10">
  <!-- Back arrow -->
  <div class="mb-6">
    <a href="<%= articles_path %>" class="inline-flex items-center text-gray-500 hover:text-gray-700 text-2xl font-medium" title="Back to Articles">
      ← Back to Articles
    </a>
  </div>

  <!-- Article card -->
  <div class="bg-white rounded-2xl shadow-md p-6 mb-8">
    <div class="flex items-center justify-between mb-6 border-b pb-2">
      <h1 class="text-4xl font-extrabold text-gray-900">
        <%= @article.title %>
      </h1>

      <div class="flex items-center space-x-4">
        <!-- Edit icon -->
        <%= link_to edit_article_path(@article), class: "text-gray-500 hover:text-gray-700 flex items-center", title: "Edit" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6">
            <path d="M21.731 2.269a2.625 2.625 0 0 0-3.712 0l-1.157 1.157 3.712 3.712 1.157-1.157a2.625 2.625 0 0 0 0-3.712ZM19.513 8.199l-3.712-3.712-8.4 8.4a5.25 5.25 0 0 0-1.32 2.214l-.8 2.685a.75.75 0 0 0 .933.933l2.685-.8a5.25 5.25 0 0 0 2.214-1.32l8.4-8.4Z" />
            <path d="M5.25 5.25a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h10.5a3 3 0 0 0 3-3V13.5a.75.75 0 0 0-1.5 0v5.25a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V8.25a1.5 1.5 0 0 1 1.5-1.5h5.25a.75.75 0 0 0 0-1.5H5.25Z" />
          </svg>
        <% end %>

        <!-- Delete icon -->
        <%= button_to article_path(@article), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-red-500 hover:text-red-700 flex items-center", title: "Delete" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 cursor-pointer">
            <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9a.75.75 0 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>
    </div>

    <p class="text-gray-700 leading-relaxed text-lg">
      <%= @article.body %>
    </p>
  </div>

  <!-- Comments section -->
<div class="bg-white rounded-2xl shadow-md p-6 mt-8">
  <h2 class="text-2xl font-bold mb-6">Comments</h2>

  <!-- Existing comments -->
  <% if @article.comments.any? %>
    <div class="space-y-4 mb-8">
      <% @article.comments.each do |comment| %>
        <div class="border-b pb-3">
          <p class="font-semibold text-gray-800">
            <%= comment.commenter %>
          </p>
          <p class="text-gray-700 mt-1">
            <%= comment.body %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-500 mb-8">No comments yet. Be the first to comment!</p>
  <% end %>

    <!-- Comment form -->
    <h3 class="text-xl font-semibold mb-2">Add a comment:</h3>
    <%= form_with model: [ @article, @article.comments.build ], class: "space-y-4" do |form| %>
      <div class="flex flex-col">
        <%= form.label :commenter, class: "mb-1 font-semibold text-gray-800" %>
        <%= form.text_field :commenter, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700" %>
      </div>

      <div class="flex flex-col">
        <%= form.label :body, class: "mb-1 font-semibold text-gray-800" %>
        <%= form.text_area :body, rows: 5, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700" %>
      </div>

      <div>
        <%= form.submit "Post Comment", class: "bg-gray-900 text-white font-semibold px-4 py-2 rounded-lg hover:bg-gray-800 transition" %>
      </div>
    <% end %>
  </div>
</div>

<div class="max-w-4xl mx-auto px-4 py-8 flex">
  <!-- Arrow column -->
  <div class="flex-shrink-0 mr-8">
    <a href="<%= articles_path %>" class="text-gray-500 hover:text-gray-700 text-2xl ">
      ←
    </a>
  </div>

  <!-- Content column -->
  <div class="flex-1">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-6">
      <%= @article.title %>
    </h1>

    <p class="text-gray-700 leading-relaxed text-lg">
      <%= @article.body %>
    </p>
  </div>
</div>

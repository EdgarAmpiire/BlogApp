<div class="w-7/12 mx-auto px-6 py-10">
  <!-- Back arrow -->
  <div class="mb-6">
    <a href="<%= articles_path %>" class="inline-flex items-center text-gray-500 hover:text-gray-700 text-2xl font-medium">
      ← Back to Articles
    </a>
  </div>

  <!-- Article card -->
  <div class="bg-white rounded-2xl shadow-md p-6">
    <div class="flex items-center justify-between mb-6 border-b pb-2">
      <h1 class="text-4xl font-extrabold text-gray-900">
        <%= @article.title %>
      </h1>

      <!-- Edit icon on the extreme right -->
      <%= link_to edit_article_path(@article), class: "text-gray-500 hover:text-gray-700 flex items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
        </svg>
      <% end %>
    </div>

    <p class="text-gray-700 leading-relaxed text-lg">
      <%= @article.body %>
    </p>
  </div>
</div>

<%= form_with model: [article, article.comments.build], local: true do |form| %>
  <div class="mb-4">
    <%= form.label :commenter, class: "block text-gray-700 font-medium mb-1" %>
    <%= form.text_field :commenter, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700" %>
  </div>

  <div class="mb-4">
    <%= form.label :body, class: "block text-gray-700 font-medium mb-1" %>
    <%= form.text_area :body, rows: 3, class: "w-full p-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-700 text-sm" %>
  </div>

  <div>
    <%= form.submit "Add Comment", class: "px-4 py-2 bg-gray-800 text-white rounded-lg hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
